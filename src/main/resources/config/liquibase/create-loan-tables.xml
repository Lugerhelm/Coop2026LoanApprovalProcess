<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="1" author="homework">
        <createTable tableName="loan_applications">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="personal_code" type="VARCHAR(11)">
                <constraints nullable="false"/>
            </column>
            <column name="loan_period_months" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="interest_margin" type="DECIMAL(10,4)">
                <constraints nullable="false"/>
            </column>
            <column name="base_interest_rate" type="DECIMAL(10,4)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="rejection_reason" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="homework">
        <createTable tableName="payment_schedules">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_application_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_loan_app" referencedTableName="loan_applications" referencedColumnNames="id"/>
            </column>
            <column name="payment_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="payment_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="monthly_payment" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>